diff --git frameworks/av/media/libstagefright/ACodec.cpp frameworks/av/media/libstagefright/ACodec.cpp
index a11494d..b385daa 100644
--- frameworks/av/media/libstagefright/ACodec.cpp
+++ frameworks/av/media/libstagefright/ACodec.cpp
@@ -2148,6 +2148,16 @@ status_t ACodec::configureCodec(
             usingSwRenderer = true;
             haveNativeWindow = false;
         }
+#ifdef MRVL_HW_DEC_USE_SW_RENDERER
+        // Marvell (PXA1908) Lollipop OMX decoders don't implement
+        // enableAndroidNativeBuffers: decode into component-allocated
+        // buffers and render them like the software codecs.
+        if (haveNativeWindow && !encoder &&
+                mComponentName.startsWith("OMX.MARVELL.VIDEO.HW.")) {
+            usingSwRenderer = true;
+            haveNativeWindow = false;
+        }
+#endif
 
         if (encoder) {
             err = setupVideoEncoder(mime, msg, outputFormat, inputFormat);
