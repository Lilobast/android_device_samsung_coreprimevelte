+void FramebufferSurface::onFrameAvailable(const BufferItem& item) {
+    {
+        Mutex::Autolock lock(mMutex);
+        mQueuedFrames++;
+        // The PXA1908 Vivante EGL dequeues and queues all framebuffer buffers in eglMakeCurrent,
+        // on SurfaceFlinger's main thread, then dequeues again: with nobody consuming until the
+        // first composition it waited forever. Drop older frames as Android 7's HWC1
+        // FramebufferSurface did (it consumed every frame in onFrameAvailable).
+        while (mQueuedFrames > 1) {
+            BufferItem old;
+            if (acquireBufferLocked(&old, 0) != NO_ERROR) {
+                break;
+            }
+            mQueuedFrames--;
+            addReleaseFenceLocked(old.mSlot, mSlots[old.mSlot].mGraphicBuffer, old.mFence);
+            releaseBufferLocked(old.mSlot, mSlots[old.mSlot].mGraphicBuffer);
+        }
+    }
+    ConsumerBase::onFrameAvailable(item);
+}
