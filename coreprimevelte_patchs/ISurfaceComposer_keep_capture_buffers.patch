             if (res == NO_ERROR) {
                 reply->write(*outBuffer);
                 reply->writeBool(capturedSecureLayers);
+                keepCaptureBufferAlive(outBuffer);
             }
             return NO_ERROR;
         }
@@ -675,6 +691,7 @@ status_t BnSurfaceComposer::onTransact(
             reply->writeInt32(res);
             if (res == NO_ERROR) {
