 namespace android {
 
+namespace {
+// Vivante gralloc names buffers by a GPU memory node, not an fd: if SurfaceFlinger
+// drops its reference while the reply is in flight, the node is freed before the
+// client imports it. Keep the last few capture buffers alive a little longer.
+void keepCaptureBufferAlive(const sp<GraphicBuffer>& buffer) {
+    static std::mutex sLock;
+    static sp<GraphicBuffer> sRecent[4];
+    static size_t sNext = 0;
+    std::lock_guard<std::mutex> lock(sLock);
+    sRecent[sNext] = buffer;
+    sNext = (sNext + 1) % 4;
+}
+} // namespace
+
 using ui::ColorMode;
 
