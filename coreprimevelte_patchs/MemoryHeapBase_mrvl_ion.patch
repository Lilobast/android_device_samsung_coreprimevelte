--- frameworks/native/libs/binder/MemoryHeapBase.cpp
+++ frameworks/native/libs/binder/MemoryHeapBase.cpp
@@ -33,6 +33,53 @@
 
 namespace android {
 
+#ifdef MRVL_ION_MEMORYHEAP
+#include <string.h>
+#include <linux/ion.h>
+
+// Marvell L behaviour: flag 0x400 picks the system heap, otherwise the carveout heap;
+// NO_CACHING drops the cache flags. The pxa1908 carveout heap is empty (the ISP uses an
+// IOMMU), so fall back to the system heap. Returns a dma-buf fd, or -errno.
+static int mrvlIonAlloc(size_t size, uint32_t heapFlags)
+{
+    const bool systemHeap = heapFlags & 0x400;
+    const uint32_t ionFlags = (heapFlags & MemoryHeapBase::NO_CACHING) ? 0 :
+            (ION_FLAG_CACHED | ION_FLAG_CACHED_NEEDS_SYNC);
+    int ionFd = open("/dev/ion", O_RDONLY | O_CLOEXEC);
+    if (ionFd < 0)
+        return -errno;
+
+    struct ion_allocation_data alloc;
+    memset(&alloc, 0, sizeof(alloc));
+    alloc.len = size;
+    alloc.align = 4096;
+    alloc.flags = ionFlags;
+    alloc.heap_id_mask = systemHeap ? ION_HEAP_SYSTEM_MASK : ION_HEAP_CARVEOUT_MASK;
+    int ret = ioctl(ionFd, ION_IOC_ALLOC, &alloc);
+    if (ret < 0 && !systemHeap) {
+        alloc.heap_id_mask = ION_HEAP_SYSTEM_MASK;
+        ret = ioctl(ionFd, ION_IOC_ALLOC, &alloc);
+    }
+    if (ret < 0) {
+        ret = -errno;
+        close(ionFd);
+        return ret;
+    }
+
+    struct ion_fd_data share;
+    memset(&share, 0, sizeof(share));
+    share.handle = alloc.handle;
+    ret = ioctl(ionFd, ION_IOC_SHARE, &share) < 0 ? -errno : share.fd;
+
+    // The shared dma-buf fd keeps the buffer alive; drop our client handle.
+    struct ion_handle_data handle;
+    handle.handle = alloc.handle;
+    ioctl(ionFd, ION_IOC_FREE, &handle);
+    close(ionFd);
+    return ret;
+}
+#endif
+
 // ---------------------------------------------------------------------------
 
 MemoryHeapBase::MemoryHeapBase()
@@ -62,6 +109,18 @@ MemoryHeapBase::MemoryHeapBase(const char* device, size_t size, uint32_t flags)
     : mFD(-1), mSize(0), mBase(MAP_FAILED), mFlags(flags),
       mDevice(0), mNeedUnmap(false), mOffset(0)
 {
+#ifdef MRVL_ION_MEMORYHEAP
+    if (device && !strcmp(device, "/dev/ion")) {
+        const size_t pagesize = getpagesize();
+        size = ((size + pagesize-1) & ~(pagesize-1));
+        int fd = mrvlIonAlloc(size, flags);
+        ALOGE_IF(fd < 0, "ion allocation of %zu bytes failed: %s", size, strerror(-fd));
+        if (fd >= 0 && mapfd(fd, size) == NO_ERROR) {
+            mDevice = device;
+        }
+        return;
+    }
+#endif
     int open_flags = O_RDWR;
     if (flags & NO_CACHING)
         open_flags |= O_SYNC;
