+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#ifndef MRVL_GCU_COPY_H_
+#define MRVL_GCU_COPY_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+namespace android {
+
+/*
+ * Copies image planes with the Vivante 2D engine (libgcu) on PXA1908.
+ *
+ * Marvell decoder output buffers are uncached, so reading them with the CPU runs at ~70 MB/s
+ * (~45 ms per 1080p frame). The 2D engine reads them at full speed. A buffer is passed by
+ * physical address when /proc/self/pagemap proves it contiguous (every page checked), otherwise
+ * by virtual address and the GPU driver maps its pages (driver mappings such as the decoder's
+ * buffers are not reported by pagemap). On any failure the caller falls back to the CPU copy.
+ * Disable with persist.mrvl.video.gcu_copy.off=1.
+ */
+class MrvlGcuCopy {
+public:
+    MrvlGcuCopy();
+    ~MrvlGcuCopy();
+
+    // Queue a copy of `rows` rows of `rowBytes` bytes. Returns false (nothing queued) when the 2D
+    // path can't be used for these buffers.
+    bool copyPlane(const void *src, size_t srcStride, void *dst, size_t dstStride,
+            size_t rowBytes, size_t rows);
+    // Wait for queued copies to complete.
+    void finish();
+
+private:
+    bool init();
+    static bool physContiguous(const void *addr, size_t len, uint32_t *phys);
+    static void *createSurface(void *context, const void *addr, size_t len, size_t stride,
+            size_t rows);
+
+    enum { kMaxSurfaces = 8 };
+
+    void *mContext;
+    bool mInitTried;
+    bool mPending;
+    void *mSurfaces[kMaxSurfaces];
+    int mNumSurfaces;
+};
+
+}  // namespace android
+
+#endif  // MRVL_GCU_COPY_H_
