+#ifdef HWC_LIVEDISPLAY_TINT
+#include <stdio.h>
+#define _REALLY_INCLUDE_SYS__SYSTEM_PROPERTIES_H_
+#include <sys/_system_properties.h>
+// LiveDisplay tint that the HW composer applies in its own composition ("r g b", 32768 = 1.0).
+// Returns true and the diagonal matrix when a non-identity tint is set.
+static bool getHwcTintMatrix(mat4& m) {
+    static const prop_info* pi = NULL;
+    static uint32_t serial = ~0u;
+    static bool active = false;
+    static float gain[3] = { 1.0f, 1.0f, 1.0f };
+    if (pi == NULL)
+        pi = __system_property_find("sys.livedisplay.rgb");
+    if (pi == NULL)
+        return false;
+    uint32_t s = __system_property_serial(pi);
+    if (s != serial) {
+        serial = s;
+        char v[PROP_VALUE_MAX];
+        __system_property_read(pi, NULL, v);
+        int rgb[3];
+        active = false;
+        if (sscanf(v, "%d %d %d", &rgb[0], &rgb[1], &rgb[2]) == 3) {
+            for (int i = 0; i < 3; i++) {
+                int c = rgb[i] < 0 ? 0 : (rgb[i] > 32768 ? 32768 : rgb[i]);
+                // same 8-bit quantisation as the HWC so both paths look identical
+                gain[i] = (float)((c * 255 + 16384) / 32768) / 255.0f;
+                if (gain[i] != 1.0f)
+                    active = true;
+            }
+        }
+    }
+    if (!active)
+        return false;
+    m = mat4();
+    m[0][0] = gain[0];
+    m[1][1] = gain[1];
+    m[2][2] = gain[2];
+    return true;
+}
+#endif
