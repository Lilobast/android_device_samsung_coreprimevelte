From cf10b1baa628836e7c1dc28ee37dc87ec2b7c513 Mon Sep 17 00:00:00 2001
From: builder <builder@localhost>
Date: Wed, 11 Nov 2026 18:35:27 +0100
Subject: [PATCH] coreprimevelte: linker: allow text relocations in platform
 (/system, /vendor) blobs

Change-Id: I307e216cd499848a0a3b4ac5928346196f161eca
---
 linker/linker.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/linker/linker.cpp b/linker/linker.cpp
index 951351c..f4bca07 100644
--- a/linker/linker.cpp
+++ b/linker/linker.cpp
@@ -3621,7 +3621,12 @@ bool soinfo::link_image(const soinfo_list_t& global_group, const soinfo_list_t&
   if (has_text_relocations) {
     // Fail if app is targeting M or above.
     int app_target_api_level = get_application_target_sdk_version();
-    if (app_target_api_level >= __ANDROID_API_M__) {
+    // coreprimevelte: Lollipop platform blobs (/system, /vendor) still have text relocations
+    // (libarac, libippsp). Allow them there; app libraries keep the API 23 rule.
+    const char* realpath = get_realpath();
+    bool platform_lib = realpath != nullptr &&
+        (strncmp(realpath, "/system/", 8) == 0 || strncmp(realpath, "/vendor/", 8) == 0);
+    if (app_target_api_level >= __ANDROID_API_M__ && !platform_lib) {
       DL_ERR_AND_LOG("\"%s\" has text relocations (https://android.googlesource.com/platform/"
                      "bionic/+/master/android-changes-for-ndk-developers.md#Text-Relocations-"
                      "Enforced-for-API-level-23)", get_realpath());
-- 
