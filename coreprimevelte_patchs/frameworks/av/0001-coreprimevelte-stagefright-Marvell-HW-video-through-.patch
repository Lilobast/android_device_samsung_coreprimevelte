diff --git a/media/libstagefright/colorconversion/SoftwareRenderer.cpp b/media/libstagefright/colorconversion/SoftwareRenderer.cpp
index 657a05b..6b41c19 100644
--- a/media/libstagefright/colorconversion/SoftwareRenderer.cpp
+++ b/media/libstagefright/colorconversion/SoftwareRenderer.cpp
@@ -28,6 +28,11 @@
 #include <ui/GraphicBufferMapper.h>
 #include <ui/GraphicBuffer.h>
 #include <ui/Rect.h>
+#include <MrvlGcuCopy.h>
+
+// Marvell gralloc NV12 (Y plane, then interleaved CbCr). The GPU and the HW composer take it
+// directly, so NV12 decoder output only needs plane copies.
+#define HAL_PIXEL_FORMAT_YCbCr_420_SP_MRVL 0x2A
 
 namespace android {
 
@@ -51,13 +56,16 @@ SoftwareRenderer::SoftwareRenderer(
       mCropWidth(0),
       mCropHeight(0),
       mRotationDegrees(rotation),
-      mDataSpace(HAL_DATASPACE_UNKNOWN) {
+      mDataSpace(HAL_DATASPACE_UNKNOWN),
+      mGcuCopy(NULL) {
     memset(&mHDRStaticInfo, 0, sizeof(mHDRStaticInfo));
 }
 
 SoftwareRenderer::~SoftwareRenderer() {
     delete mConverter;
     mConverter = NULL;
+    delete mGcuCopy;
+    mGcuCopy = NULL;
 }
 
 void SoftwareRenderer::resetFormatIfChanged(
@@ -122,8 +130,14 @@ void SoftwareRenderer::resetFormatIfChanged(
     // hardware has YUV12 and RGBA8888 support, so convert known formats
     {
         switch (mColorFormat) {
-            case OMX_COLOR_FormatYUV420Planar:
             case OMX_COLOR_FormatYUV420SemiPlanar:
+            {
+                halFormat = HAL_PIXEL_FORMAT_YCbCr_420_SP_MRVL;
+                bufWidth = (mCropWidth + 1) & ~1;
+                bufHeight = (mCropHeight + 1) & ~1;
+                break;
+            }
+            case OMX_COLOR_FormatYUV420Planar:
             case OMX_TI_COLOR_FormatYUV420PackedSemiPlanar:
             {
                 halFormat = HAL_PIXEL_FORMAT_YV12;
@@ -242,7 +256,7 @@ void SoftwareRenderer::clearTracker() {
 }
 
 std::list<FrameRenderTracker::Info> SoftwareRenderer::render(
-        const void *data, size_t , int64_t mediaTimeUs, nsecs_t renderTimeNs,
+        const void *data, size_t size, int64_t mediaTimeUs, nsecs_t renderTimeNs,
         size_t numOutputBuffers, const sp<AMessage>& format) {
     resetFormatIfChanged(format, numOutputBuffers);
     FrameRenderTracker::Info *info = NULL;
@@ -358,6 +372,51 @@ std::list<FrameRenderTracker::Info> SoftwareRenderer::render(
             dst_u += dst_c_stride;
             dst_v += dst_c_stride;
         }
+    } else if (mColorFormat == OMX_COLOR_FormatYUV420SemiPlanar) {
+        // NV12 -> Marvell NV12 gralloc buffer: copy both planes as-is.
+        if ((size_t)mWidth * mHeight * 3 / 2 > size) {
+            goto skip_copying;
+        }
+        const uint8_t *src_y = (const uint8_t *)data;
+        const uint8_t *src_uv = (const uint8_t *)data
+                + mWidth * (mHeight - mCropTop / 2);
+        uint8_t *dst_y = (uint8_t *)dst;
+        // The Vivante driver finds the chroma plane at stride * align(height, 4)
+        // (verified at 720p/1080p on 14.1; 64-row alignment is only for allocation size).
+        uint8_t *dst_uv = dst_y + buf->stride * ALIGN(buf->height, 4);
+        size_t rowBytes = (mCropWidth + 1) & ~1;
+        size_t uvRows = (mCropHeight + 1) / 2;
+
+        // The 2D engine reads the source (also needed when the codec process wrote it with the
+        // 2D engine: the CPU could see stale cache lines).
+        if (mGcuCopy == NULL) {
+            mGcuCopy = new MrvlGcuCopy();
+        }
+        bool copied = mGcuCopy->copyPlane(src_y, mWidth, dst_y, buf->stride, rowBytes, mCropHeight)
+                && mGcuCopy->copyPlane(src_uv, mWidth, dst_uv, buf->stride, rowBytes, uvRows);
+        mGcuCopy->finish();
+        if (!copied) {
+            static int sLogged = 0;
+            if (sLogged++ < 3) {
+                ALOGW("NV12 2D copy failed, CPU copy (%dx%d stride %d)",
+                        mCropWidth, mCropHeight, buf->stride);
+            }
+            if (buf->stride == mWidth && rowBytes == (size_t)mWidth) {
+                memcpy(dst_y, src_y, rowBytes * mCropHeight);
+                memcpy(dst_uv, src_uv, rowBytes * uvRows);
+            } else {
+                for (int y = 0; y < mCropHeight; ++y) {
+                    memcpy(dst_y, src_y, rowBytes);
+                    src_y += mWidth;
+                    dst_y += buf->stride;
+                }
+                for (size_t y = 0; y < uvRows; ++y) {
+                    memcpy(dst_uv, src_uv, rowBytes);
+                    src_uv += mWidth;
+                    dst_uv += buf->stride;
+                }
+            }
+        }
     } else if (mColorFormat == OMX_TI_COLOR_FormatYUV420PackedSemiPlanar
             || mColorFormat == OMX_COLOR_FormatYUV420SemiPlanar) {
         const uint8_t *src_y = (const uint8_t *)data;
