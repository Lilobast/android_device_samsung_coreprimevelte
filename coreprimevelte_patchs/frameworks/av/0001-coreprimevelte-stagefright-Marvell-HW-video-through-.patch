From a71ab86d10a4fb82f0ebffa2b97e99c99dc26e7b Mon Sep 17 00:00:00 2001
From: builder <builder@localhost>
Date: Wed, 11 Nov 2026 19:37:07 +0100
Subject: [PATCH 1/4] coreprimevelte: stagefright: Marvell HW video through
 SoftwareRenderer, NV12 and 2D-engine copies

Change-Id: If597fc1d779d836f8c4fd021458991e6932c6af9
---
 media/libstagefright/ACodec.cpp               | 32 +++++++++
 media/libstagefright/Android.bp               |  1 +
 .../libstagefright/colorconversion/Android.bp |  5 +-
 .../colorconversion/SoftwareRenderer.cpp      | 65 ++++++++++++++++++-
 .../libstagefright/include/SoftwareRenderer.h |  3 +
 media/libstagefright/omx/Android.bp           |  2 +
 media/libstagefright/omx/OMXNodeInstance.cpp  | 39 ++++++++++-
 .../media/stagefright/omx/OMXNodeInstance.h   |  6 ++
 8 files changed, 148 insertions(+), 5 deletions(-)

diff --git a/media/libstagefright/ACodec.cpp b/media/libstagefright/ACodec.cpp
index 014dfa9..ac0e4bf 100644
--- a/media/libstagefright/ACodec.cpp
+++ b/media/libstagefright/ACodec.cpp
@@ -59,6 +59,7 @@
 #include "include/SecureBuffer.h"
 #include "include/SharedMemoryBuffer.h"
 #include <media/stagefright/omx/OMXUtils.h>
+#include <MrvlGcuCopy.h>
 
 namespace android {
 
@@ -2020,10 +2021,21 @@ status_t ACodec::configureCodec(
     if (mIsVideo || mIsImage) {
         // determine need for software renderer
         bool usingSwRenderer = false;
+        bool mrvlGpuOutput = false;
         if (haveNativeWindow && mComponentName.startsWith("OMX.google.")) {
             usingSwRenderer = true;
             haveNativeWindow = false;
             (void)setPortMode(kPortIndexOutput, IOMX::kPortModePresetByteBuffer);
+        } else if (haveNativeWindow && !encoder
+                && mComponentName.startsWith("OMX.MARVELL.VIDEO.HW.")
+                && !mComponentName.endsWith(".secure")) {
+            // pxa1908: the Lollipop Marvell HW decoders don't implement Android native buffers.
+            // Decode into component buffers and render them like the software codecs
+            // (SoftwareRenderer copies NV12 into a Marvell NV12 gralloc buffer).
+            usingSwRenderer = true;
+            haveNativeWindow = false;
+            (void)setPortMode(kPortIndexOutput, IOMX::kPortModePresetByteBuffer);
+            mrvlGpuOutput = MrvlGcuCopy::available();
         } else if (haveNativeWindow && !storingMetadataInDecodedBuffers()) {
             err = setPortMode(kPortIndexOutput, IOMX::kPortModePresetANWBuffer);
             if (err != OK) {
@@ -2041,6 +2053,26 @@ status_t ACodec::configureCodec(
             return err;
         }
 
+        if (mrvlGpuOutput) {
+            // The decoder's output buffers are uncached (~45 ms CPU read per 1080p frame). Let the
+            // codec process copy them out with the 2D engine. Only safe because this process
+            // renders them with the 2D engine too (the GPU writes are not visible to CPU caches):
+            // NV12 output, SoftwareRenderer, 2D engine usable here.
+            OMX_PARAM_PORTDEFINITIONTYPE def;
+            InitOMXParams(&def);
+            def.nPortIndex = kPortIndexOutput;
+            if (mOMXNode->getParameter(OMX_IndexParamPortDefinition, &def, sizeof(def)) == OK
+                    && def.format.video.eColorFormat == OMX_COLOR_FormatYUV420SemiPlanar) {
+                OMX_CONFIG_BOOLEANTYPE enable;
+                InitOMXParams(&enable);
+                enable.bEnabled = OMX_TRUE;
+                status_t gpuErr = mOMXNode->setParameter(
+                        (OMX_INDEXTYPE)kMrvlIndexGpuCopyOutput, &enable, sizeof(enable));
+                ALOGI("[%s] 2D-engine output copy %s", mComponentName.c_str(),
+                        gpuErr == OK ? "enabled" : "refused");
+            }
+        }
+
         if (haveNativeWindow) {
             mNativeWindow = static_cast<Surface *>(obj.get());
 
