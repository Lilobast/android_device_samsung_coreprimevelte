diff --git a/media/libstagefright/omx/OMXNodeInstance.cpp b/media/libstagefright/omx/OMXNodeInstance.cpp
index cfab2da..d07d3ea 100644
--- a/media/libstagefright/omx/OMXNodeInstance.cpp
+++ b/media/libstagefright/omx/OMXNodeInstance.cpp
@@ -31,6 +31,7 @@
 #include <media/openmax/OMX_AsString.h>
 
 #include <binder/IMemory.h>
+#include <MrvlGcuCopy.h>
 #include <cutils/properties.h>
 #include <gui/BufferQueue.h>
 #include <media/hardware/HardwareAPI.h>
@@ -142,6 +143,19 @@ struct BufferMeta {
         memcpy(getPointer() + header->nOffset, codec->data(), codec->size());
     }
 
+    // pxa1908: CopyFromOMX with the 2D engine (the source is uncached). Returns false when it
+    // could not be used; the caller then copies with the CPU.
+    bool CopyFromOMXGpu(const OMX_BUFFERHEADERTYPE *header, MrvlGcuCopy *gcu) {
+        if (!mCopyFromOmx) {
+            return false;
+        }
+        sp<ABuffer> codec = getBuffer(header, true /* limit */);
+        if (codec->size() == 0 || getPointer() == nullptr) {
+            return false;
+        }
+        return gcu->copyLinear(codec->data(), getPointer() + header->nOffset, codec->size());
+    }
+
     void CopyToOMX(const OMX_BUFFERHEADERTYPE *header) {
         if (!mCopyToOmx) {
             return;
@@ -352,6 +366,8 @@ OMXNodeInstance::OMXNodeInstance(
       mSailed(false),
       mQueriedProhibitedExtensions(false),
       mQuirks(0),
+      mMrvlGpuCopyOutput(false),
+      mMrvlGcu(NULL),
       mBufferIDCount(0),
       mRestorePtsFailed(false),
       mMaxTimestampGapUs(0ll),
@@ -379,6 +395,8 @@ OMXNodeInstance::OMXNodeInstance(
 }
 
 OMXNodeInstance::~OMXNodeInstance() {
+    delete mMrvlGcu;
+    mMrvlGcu = NULL;
     free(mName);
     CHECK(mHandle == NULL);
 }
@@ -627,6 +645,22 @@ status_t OMXNodeInstance::setParameter(
         return setMaxPtsGapUs(params, size);
     }
 
+    // pxa1908: handled here, never passed to the component. Sent by ACodec only when the client
+    // renders the output with the 2D engine as well (see MrvlGcuCopy.h).
+    if ((uint32_t)index == kMrvlIndexGpuCopyOutput) {
+        const OMX_CONFIG_BOOLEANTYPE *enable = (const OMX_CONFIG_BOOLEANTYPE *)params;
+        if (params == NULL || size < sizeof(*enable) || mName == NULL
+                || strstr(mName, "MARVELL.VIDEO.HW.") == NULL || strstr(mName, "secure") != NULL) {
+            return BAD_VALUE;
+        }
+        mMrvlGpuCopyOutput = enable->bEnabled == OMX_TRUE;
+        if (mMrvlGpuCopyOutput && mMrvlGcu == NULL) {
+            mMrvlGcu = new MrvlGcuCopy();  // context created on first use (callback thread)
+        }
+        ALOGI("[%s] 2D-engine output copy %s", mName, mMrvlGpuCopyOutput ? "on" : "off");
+        return OK;
+    }
+
     if (isProhibitedIndex_l(index)) {
         android_errorWriteLog(0x534e4554, "29422020");
         return BAD_INDEX;
@@ -2043,7 +2077,10 @@ bool OMXNodeInstance::handleMessage(omx_message &msg) {
             CLOG_ERROR(onFillBufferDone, OMX_ErrorBadParameter,
                     FULL_BUFFER(NULL, buffer, msg.fenceFd));
         }
-        buffer_meta->CopyFromOMX(buffer);
+        if (!(mMrvlGpuCopyOutput && mMrvlGcu != NULL
+                && buffer_meta->CopyFromOMXGpu(buffer, mMrvlGcu))) {
+            buffer_meta->CopyFromOMX(buffer);
+        }
 
         // fix up the buffer info (especially timestamp) if needed
         codecBufferFilled(msg);
