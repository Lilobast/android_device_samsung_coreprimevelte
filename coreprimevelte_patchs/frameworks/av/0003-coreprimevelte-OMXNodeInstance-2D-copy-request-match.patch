From 4e47b033a1c768cb1ffb8b05b91938dc87b8e3ce Mon Sep 17 00:00:00 2001
From: builder <builder@localhost>
Date: Thu, 12 Nov 2026 06:06:03 +0100
Subject: [PATCH 3/4] coreprimevelte: OMXNodeInstance: 2D copy request matches
 Pie's short node name

Change-Id: I80f14e49eb550ff0744f16e2435f2bd2d13b37b3
---
 media/libstagefright/omx/OMXNodeInstance.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/media/libstagefright/omx/OMXNodeInstance.cpp b/media/libstagefright/omx/OMXNodeInstance.cpp
index d07d3ea..49d288e 100644
--- a/media/libstagefright/omx/OMXNodeInstance.cpp
+++ b/media/libstagefright/omx/OMXNodeInstance.cpp
@@ -649,8 +649,11 @@ status_t OMXNodeInstance::setParameter(
     // renders the output with the 2D engine as well (see MrvlGcuCopy.h).
     if ((uint32_t)index == kMrvlIndexGpuCopyOutput) {
         const OMX_CONFIG_BOOLEANTYPE *enable = (const OMX_CONFIG_BOOLEANTYPE *)params;
+        // mName is the shortened debug name on Pie ("MARVELL.HW.CODA7542DECODER"), the full
+        // component name ("OMX.MARVELL.VIDEO.HW.*") on older releases.
         if (params == NULL || size < sizeof(*enable) || mName == NULL
-                || strstr(mName, "MARVELL.VIDEO.HW.") == NULL || strstr(mName, "secure") != NULL) {
+                || strstr(mName, "MARVELL.") == NULL || strstr(mName, "HW.") == NULL
+                || strstr(mName, "secure") != NULL) {
             return BAD_VALUE;
         }
         mMrvlGpuCopyOutput = enable->bEnabled == OMX_TRUE;
