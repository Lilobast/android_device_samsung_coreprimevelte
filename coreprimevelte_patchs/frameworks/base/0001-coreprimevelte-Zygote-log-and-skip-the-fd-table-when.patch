From b8b67f91c1152cef0474c0c5884a442e4fd72ab9 Mon Sep 17 00:00:00 2001
From: builder <builder@localhost>
Date: Wed, 11 Nov 2026 19:09:40 +0100
Subject: [PATCH 1/5] coreprimevelte: Zygote: log and skip the fd table when
 blobs keep files open

Change-Id: I416c4b0f165aa335953932d63e41e5d7c1896c9c
---
 core/jni/com_android_internal_os_Zygote.cpp | 15 ++++++++++-----
 1 file changed, 10 insertions(+), 5 deletions(-)

diff --git a/core/jni/com_android_internal_os_Zygote.cpp b/core/jni/com_android_internal_os_Zygote.cpp
index 223af68b..29a161ac 100644
--- a/core/jni/com_android_internal_os_Zygote.cpp
+++ b/core/jni/com_android_internal_os_Zygote.cpp
@@ -517,6 +517,7 @@ void SetThreadName(const char* thread_name) {
 
 // The list of open zygote file descriptors.
 static FileDescriptorTable* gOpenFdTable = NULL;
+static bool gSkipFdTable = false;
 
 static bool FillFileDescriptorVector(JNIEnv* env,
                                      jintArray java_fds,
@@ -592,13 +593,17 @@ static pid_t ForkAndSpecializeCommon(JNIEnv* env, uid_t uid, gid_t gid, jintArra
   if (!FillFileDescriptorVector(env, fdsToIgnore, &fds_to_ignore, &error_msg)) {
     fail_fn(error_msg);
   }
-  if (gOpenFdTable == NULL) {
+  // pxa1908: the Lollipop GPU/Samsung blobs loaded at preload keep device files open that
+  // are not whitelisted. Log the file once and fork without the table instead of aborting.
+  if (gOpenFdTable == NULL && !gSkipFdTable) {
     gOpenFdTable = FileDescriptorTable::Create(fds_to_ignore, &error_msg);
     if (gOpenFdTable == NULL) {
-      fail_fn(error_msg);
+      ALOGW("Zygote fd table disabled: %s", error_msg.c_str());
+      gSkipFdTable = true;
     }
-  } else if (!gOpenFdTable->Restat(fds_to_ignore, &error_msg)) {
-    fail_fn(error_msg);
+  } else if (gOpenFdTable != NULL && !gOpenFdTable->Restat(fds_to_ignore, &error_msg)) {
+    ALOGW("Zygote fd table disabled after restat: %s", error_msg.c_str());
+    gSkipFdTable = true;
   }
 
   pid_t pid = fork();
@@ -613,7 +618,7 @@ static pid_t ForkAndSpecializeCommon(JNIEnv* env, uid_t uid, gid_t gid, jintArra
 
     // Re-open all remaining open file descriptors so that they aren't shared
     // with the zygote across a fork.
-    if (!gOpenFdTable->ReopenOrDetach(&error_msg)) {
+    if (!gSkipFdTable && !gOpenFdTable->ReopenOrDetach(&error_msg)) {
       fail_fn(error_msg);
     }
 
-- 
