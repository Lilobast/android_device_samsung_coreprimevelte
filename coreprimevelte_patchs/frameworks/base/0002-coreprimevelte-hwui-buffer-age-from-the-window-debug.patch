From 3e69ad1e9f18578e03ee0c3e8f0ff635434c0ea8 Mon Sep 17 00:00:00 2001
From: builder <builder@localhost>
Date: Wed, 11 Nov 2026 19:11:01 +0100
Subject: [PATCH 2/5] coreprimevelte: hwui: buffer age from the window
 (debug.hwui.window_buffer_age)

Change-Id: I911dd4375ad7ec2524b2ac4269b003b173ff18f0
---
 libs/hwui/renderthread/EglManager.cpp | 18 ++++++++++++++++++
 libs/hwui/renderthread/EglManager.h   |  7 +++++++
 2 files changed, 25 insertions(+)

diff --git a/libs/hwui/renderthread/EglManager.cpp b/libs/hwui/renderthread/EglManager.cpp
index 6e239e35..a3d16155 100644
--- a/libs/hwui/renderthread/EglManager.cpp
+++ b/libs/hwui/renderthread/EglManager.cpp
@@ -19,6 +19,7 @@
 #include <string>
 
 #include <cutils/properties.h>
+#include <system/window.h>
 #include <log/log.h>
 #include "utils/StringUtils.h"
 
@@ -122,6 +123,8 @@ void EglManager::initialize() {
             mSwapBehavior = SwapBehavior::Preserved;
         }
     }
+    mBufferAgeFromWindow = property_get_bool("debug.hwui.window_buffer_age", false);
+    ALOGI_IF(mBufferAgeFromWindow, "Buffer age taken from the window (BufferQueue), not EGL");
 
     loadConfigs();
     createContext();
@@ -335,6 +338,7 @@ EGLSurface EglManager::createSurface(EGLNativeWindowType window, bool wideColorG
                             (void*)window, eglErrorString());
     }
 
+    mSurfaceWindows[surface] = window;
     return surface;
 }
 
@@ -342,6 +346,7 @@ void EglManager::destroySurface(EGLSurface surface) {
     if (isCurrent(surface)) {
         makeCurrent(EGL_NO_SURFACE);
     }
+    mSurfaceWindows.erase(surface);
     if (!eglDestroySurface(mEglDisplay, surface)) {
         ALOGW("Failed to destroy surface %p, error=%s", (void*)surface, eglErrorString());
     }
@@ -402,6 +407,16 @@ EGLint EglManager::queryBufferAge(EGLSurface surface) {
     return 0;
 }
 
+// The EGL buffer-age query makes the driver dequeue its next buffer, so the window
+// query refers to the same buffer.
+EGLint EglManager::queryWindowBufferAge(EGLSurface surface, EGLint eglAge) {
+    auto it = mSurfaceWindows.find(surface);
+    if (it == mSurfaceWindows.end() || !it->second) return eglAge;
+    int windowAge = 0;
+    if (it->second->query(it->second, NATIVE_WINDOW_BUFFER_AGE, &windowAge) != 0) return eglAge;
+    return windowAge;
+}
+
 Frame EglManager::beginFrame(EGLSurface surface) {
     LOG_ALWAYS_FATAL_IF(surface == EGL_NO_SURFACE, "Tried to beginFrame on EGL_NO_SURFACE!");
     makeCurrent(surface);
@@ -410,6 +425,9 @@ Frame EglManager::beginFrame(EGLSurface surface) {
     eglQuerySurface(mEglDisplay, surface, EGL_WIDTH, &frame.mWidth);
     eglQuerySurface(mEglDisplay, surface, EGL_HEIGHT, &frame.mHeight);
     frame.mBufferAge = queryBufferAge(surface);
+    if (mBufferAgeFromWindow && mSwapBehavior == SwapBehavior::BufferAge) {
+        frame.mBufferAge = queryWindowBufferAge(surface, frame.mBufferAge);
+    }
     eglBeginFrame(mEglDisplay, surface);
     return frame;
 }
diff --git a/libs/hwui/renderthread/EglManager.h b/libs/hwui/renderthread/EglManager.h
index ef9effbf..a31e030f 100644
--- a/libs/hwui/renderthread/EglManager.h
+++ b/libs/hwui/renderthread/EglManager.h
@@ -18,6 +18,7 @@
 
 #include <EGL/egl.h>
 #include <SkRect.h>
+#include <map>
 #include <cutils/compiler.h>
 #include <ui/GraphicBuffer.h>
 #include <utils/StrongPointer.h>
@@ -71,6 +72,7 @@ private:
     void loadConfigs();
     void createContext();
     EGLint queryBufferAge(EGLSurface surface);
+    EGLint queryWindowBufferAge(EGLSurface surface, EGLint eglAge);
 
     RenderThread& mRenderThread;
 
@@ -88,6 +90,11 @@ private:
         BufferAge,
     };
     SwapBehavior mSwapBehavior = SwapBehavior::Discard;
+
+    // debug.hwui.window_buffer_age: take the buffer age from the window (BufferQueue)
+    // instead of the EGL driver. Window of each EGL surface, set in createSurface.
+    bool mBufferAgeFromWindow = false;
+    std::map<EGLSurface, EGLNativeWindowType> mSurfaceWindows;
 };
 
 } /* namespace renderthread */
-- 
2.17.1

