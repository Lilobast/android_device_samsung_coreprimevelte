From cfa40e436824fdb5592746b1c6a05b3c97bbe93c Mon Sep 17 00:00:00 2001
From: builder <builder@localhost>
Date: Thu, 12 Nov 2026 02:19:31 +0100
Subject: [PATCH 4/5] Revert "coreprimevelte: hwui: optional CPU upload of
 hardware bitmaps (ro.hwui.hw_bitmap_cpu_upload)"

This reverts commit 3ae7c5943f226b323c63c513b44daea2978575be.
---
 .../hwui/pipeline/skia/SkiaOpenGLPipeline.cpp | 28 ++-----------------
 1 file changed, 2 insertions(+), 26 deletions(-)

diff --git a/libs/hwui/pipeline/skia/SkiaOpenGLPipeline.cpp b/libs/hwui/pipeline/skia/SkiaOpenGLPipeline.cpp
index 816f4b9d..270527d5 100644
--- a/libs/hwui/pipeline/skia/SkiaOpenGLPipeline.cpp
+++ b/libs/hwui/pipeline/skia/SkiaOpenGLPipeline.cpp
@@ -326,9 +326,6 @@ sk_sp<Bitmap> SkiaOpenGLPipeline::allocateHardwareBitmap(renderthread::RenderThr
     PixelFormat pixelFormat;
     GLint format, type;
     bool isSupported = false;
-    // Some legacy GPUs (Vivante GC on PXA1908) never write glTexSubImage2D() data on an
-    // EGLImage-backed texture back to the gralloc buffer: fill the buffer from the CPU instead.
-    static const bool cpuUpload = property_get_bool("ro.hwui.hw_bitmap_cpu_upload", false);
 
     // TODO: add support for linear blending (when ANDROID_ENABLE_LINEAR_BLENDING is defined)
     switch (info.colorType()) {
@@ -358,7 +355,7 @@ sk_sp<Bitmap> SkiaOpenGLPipeline::allocateHardwareBitmap(renderthread::RenderThr
             type = GL_UNSIGNED_SHORT_5_6_5;
             break;
         case kGray_8_SkColorType:
-            isSupported = !cpuUpload;
+            isSupported = true;
             pixelFormat = PIXEL_FORMAT_RGBA_8888;
             format = GL_LUMINANCE;
             type = GL_UNSIGNED_BYTE;
@@ -385,12 +382,9 @@ sk_sp<Bitmap> SkiaOpenGLPipeline::allocateHardwareBitmap(renderthread::RenderThr
         }
     }
 
-    const bool cpuCopy = cpuUpload && pixelFormat != PIXEL_FORMAT_RGBA_FP16;
     sp<GraphicBuffer> buffer = new GraphicBuffer(
             info.width(), info.height(), pixelFormat,
-            GraphicBuffer::USAGE_HW_TEXTURE |
-                    (cpuCopy ? GraphicBuffer::USAGE_SW_WRITE_OFTEN
-                             : GraphicBuffer::USAGE_SW_WRITE_NEVER) |
+            GraphicBuffer::USAGE_HW_TEXTURE | GraphicBuffer::USAGE_SW_WRITE_NEVER |
                     GraphicBuffer::USAGE_SW_READ_NEVER,
             std::string("Bitmap::allocateSkiaHardwareBitmap pid [") + std::to_string(getpid()) +
                     "]");
@@ -401,24 +395,6 @@ sk_sp<Bitmap> SkiaOpenGLPipeline::allocateHardwareBitmap(renderthread::RenderThr
         return nullptr;
     }
 
-    if (cpuCopy) {
-        void* dst = nullptr;
-        if (buffer->lock(GraphicBuffer::USAGE_SW_WRITE_OFTEN, &dst) != OK || dst == nullptr) {
-            ALOGW("hardware bitmap: lock failed");
-            return nullptr;
-        }
-        const size_t bpp = bitmap.info().bytesPerPixel();
-        const size_t rowBytes = bitmap.info().width() * bpp;
-        const size_t dstStride = buffer->getStride() * bpp;
-        const uint8_t* src = static_cast<const uint8_t*>(bitmap.getPixels());
-        for (int y = 0; y < bitmap.info().height(); y++) {
-            memcpy(static_cast<uint8_t*>(dst) + y * dstStride, src + y * bitmap.rowBytes(),
-                   rowBytes);
-        }
-        buffer->unlock();
-        return sk_sp<Bitmap>(new Bitmap(buffer.get(), bitmap.info()));
-    }
-
     // upload the bitmap into a texture
     EGLDisplay display = eglGetCurrentDisplay();
     LOG_ALWAYS_FATAL_IF(display == EGL_NO_DISPLAY, "Failed to get EGL_DEFAULT_DISPLAY! err=%s",
-- 
