From 35989dba39d9249eb6c638b574ebbab6b61e704c Mon Sep 17 00:00:00 2001
From: builder <builder@localhost>
Date: Wed, 11 Nov 2026 19:11:01 +0100
Subject: [PATCH 1/5] coreprimevelte: MemoryHeapBase: Marvell /dev/ion heaps
 through libion

Change-Id: Ic02a47b2d11cb017b8c1ed37fab64d1459c2ba01
---
 libs/binder/Android.bp         |  1 +
 libs/binder/MemoryHeapBase.cpp | 33 +++++++++++++++++++++++++++++++++
 2 files changed, 34 insertions(+)

diff --git a/libs/binder/Android.bp b/libs/binder/Android.bp
index 78c70ea..f01259f 100644
--- a/libs/binder/Android.bp
+++ b/libs/binder/Android.bp
@@ -113,6 +113,7 @@ cc_library {
     },
 
     shared_libs: [
+        "libion",
         "libbase",
         "liblog",
         "libcutils",
diff --git a/libs/binder/MemoryHeapBase.cpp b/libs/binder/MemoryHeapBase.cpp
index 03f00be..31266e2 100644
--- a/libs/binder/MemoryHeapBase.cpp
+++ b/libs/binder/MemoryHeapBase.cpp
@@ -30,8 +30,31 @@
 #include <cutils/atomic.h>
 #include <log/log.h>
 
+#include <string.h>
+#include <ion/ion.h>
+
 namespace android {
 
+// Marvell Lollipop behaviour for MemoryHeapBase("/dev/ion"): flag 0x400 picks the system heap,
+// otherwise the carveout heap; NO_CACHING drops the cache flags. The pxa1908 carveout heap is
+// empty (the ISP uses an IOMMU), so fall back to the system heap. Returns a dma-buf fd or -errno.
+static int mrvlIonAlloc(size_t size, uint32_t heapFlags)
+{
+    const bool systemHeap = heapFlags & 0x400;
+    const unsigned int ionFlags = (heapFlags & MemoryHeapBase::NO_CACHING) ? 0 :
+            (ION_FLAG_CACHED | ION_FLAG_CACHED_NEEDS_SYNC);
+    int ionFd = ion_open();
+    if (ionFd < 0)
+        return ionFd;
+    int shareFd = -1;
+    int ret = ion_alloc_fd(ionFd, size, 4096,
+            systemHeap ? ION_HEAP_SYSTEM_MASK : ION_HEAP_CARVEOUT_MASK, ionFlags, &shareFd);
+    if (ret < 0 && !systemHeap)
+        ret = ion_alloc_fd(ionFd, size, 4096, ION_HEAP_SYSTEM_MASK, ionFlags, &shareFd);
+    ion_close(ionFd);
+    return ret < 0 ? ret : shareFd;
+}
+
 // ---------------------------------------------------------------------------
 
 MemoryHeapBase::MemoryHeapBase()
@@ -61,6 +84,16 @@ MemoryHeapBase::MemoryHeapBase(const char* device, size_t size, uint32_t flags)
     : mFD(-1), mSize(0), mBase(MAP_FAILED), mFlags(flags),
       mDevice(0), mNeedUnmap(false), mOffset(0)
 {
+    if (device && !strcmp(device, "/dev/ion")) {
+        const size_t pagesize = getpagesize();
+        size = ((size + pagesize-1) & ~(pagesize-1));
+        int fd = mrvlIonAlloc(size, flags);
+        ALOGE_IF(fd < 0, "ion allocation of %zu bytes failed: %s", size, strerror(-fd));
+        if (fd >= 0 && mapfd(fd, size) == NO_ERROR) {
+            mDevice = device;
+        }
+        return;
+    }
     int open_flags = O_RDWR;
     if (flags & NO_CACHING)
         open_flags |= O_SYNC;
-- 
