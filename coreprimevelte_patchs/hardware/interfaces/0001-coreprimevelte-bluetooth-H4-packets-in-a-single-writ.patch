From 86955f40e349f7606c7f32b3c24a1848793a5139 Mon Sep 17 00:00:00 2001
From: builder <builder@localhost>
Date: Thu, 12 Nov 2026 01:32:58 +0100
Subject: [PATCH 1/5] coreprimevelte: bluetooth: H4 packets in a single write

Change-Id: Iad03f6cc086bd58d8d3239950052cd8beceb9a26
---
 bluetooth/1.0/default/h4_protocol.cc | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/bluetooth/1.0/default/h4_protocol.cc b/bluetooth/1.0/default/h4_protocol.cc
index df40507..c56d75e 100644
--- a/bluetooth/1.0/default/h4_protocol.cc
+++ b/bluetooth/1.0/default/h4_protocol.cc
@@ -19,22 +19,28 @@
 #define LOG_TAG "android.hardware.bluetooth-hci-h4"
 
 #include <errno.h>
+#include <string.h>
 #include <fcntl.h>
 #include <log/log.h>
 #include <sys/uio.h>
 #include <unistd.h>
 
+#include <vector>
+
 namespace android {
 namespace hardware {
 namespace bluetooth {
 namespace hci {
 
 size_t H4Protocol::Send(uint8_t type, const uint8_t* data, size_t length) {
-  struct iovec iov[] = {{&type, sizeof(type)},
-                        {const_cast<uint8_t*>(data), length}};
+  // One write() per packet: character-device transports without writev support (Marvell
+  // mbtchar) see each iovec as a separate packet and reject the 1-byte packet type.
+  std::vector<uint8_t> packet(length + 1);
+  packet[0] = type;
+  if (length > 0) memcpy(packet.data() + 1, data, length);
   ssize_t ret = 0;
   do {
-    ret = TEMP_FAILURE_RETRY(writev(uart_fd_, iov, sizeof(iov) / sizeof(iov[0])));
+    ret = TEMP_FAILURE_RETRY(write(uart_fd_, packet.data(), packet.size()));
   } while (-1 == ret && EAGAIN == errno);
 
   if (ret == -1) {
