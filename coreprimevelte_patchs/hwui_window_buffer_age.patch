diff --git frameworks/base/libs/hwui/renderthread/EglManager.cpp frameworks/base/libs/hwui/renderthread/EglManager.cpp
index ac6a28fe628..cea065d8633 100644
--- frameworks/base/libs/hwui/renderthread/EglManager.cpp
+++ frameworks/base/libs/hwui/renderthread/EglManager.cpp
@@ -25,6 +25,7 @@
 #include <cutils/log.h>
 #include <cutils/properties.h>
 #include <EGL/eglext.h>
+#include <system/window.h>
 #include <string>
 
 #define GLES_VERSION 2
@@ -121,6 +122,10 @@ void EglManager::initialize() {
             mSwapBehavior = SwapBehavior::Preserved;
         }
     }
+    mBufferAgeFromWindow = property_get_bool("debug.hwui.window_buffer_age", false);
+    if (mBufferAgeFromWindow) {
+        ALOGI("Buffer age taken from the window (BufferQueue), not EGL");
+    }
 
     loadConfig();
     createContext();
@@ -298,7 +303,7 @@ EGLint EglManager::queryBufferAge(EGLSurface surface) {
     return 0;
 }
 
-Frame EglManager::beginFrame(EGLSurface surface) {
+Frame EglManager::beginFrame(EGLSurface surface, EGLNativeWindowType window) {
     LOG_ALWAYS_FATAL_IF(surface == EGL_NO_SURFACE,
             "Tried to beginFrame on EGL_NO_SURFACE!");
     makeCurrent(surface);
@@ -306,7 +311,19 @@ Frame EglManager::beginFrame(EGLSurface surface) {
     frame.mSurface = surface;
     eglQuerySurface(mEglDisplay, surface, EGL_WIDTH, &frame.mWidth);
     eglQuerySurface(mEglDisplay, surface, EGL_HEIGHT, &frame.mHeight);
+    // The EGL query also makes the driver dequeue its next buffer, so the
+    // window query below refers to the same buffer.
     frame.mBufferAge = queryBufferAge(surface);
+    if (mBufferAgeFromWindow && window && mSwapBehavior == SwapBehavior::BufferAge) {
+        int windowAge = 0;
+        if (window->query(window, NATIVE_WINDOW_BUFFER_AGE, &windowAge) == 0) {
+            if (mBufferAgeLogFrames < 30) {
+                ALOGV("buffer age: egl %d, window %d", frame.mBufferAge, windowAge);
+                mBufferAgeLogFrames++;
+            }
+            frame.mBufferAge = windowAge;
+        }
+    }
     eglBeginFrame(mEglDisplay, surface);
     return frame;
 }
