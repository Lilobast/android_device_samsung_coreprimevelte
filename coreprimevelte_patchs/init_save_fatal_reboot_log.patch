+// coreprimevelte bring-up: init's fatal paths reboot to "bootloader", which this kernel turns into
+// recovery, and ramoops does not survive TWRP. Save the kernel log (it holds init's log) to the
+// cache partition first, so it can be read from TWRP: /cache/init_fatal_kmsg.txt (previous: .1).
+static void SaveFatalRebootLog(const std::string& rebootTarget) {
+    if (getpid() != 1 || rebootTarget.compare(0, 10, "bootloader") != 0) return;
+    std::string dev;
+    if (!android::base::ReadFileToString("/sys/class/block/mmcblk0p17/dev", &dev)) return;
+    unsigned int maj, min;
+    if (sscanf(dev.c_str(), "%u:%u", &maj, &min) != 2) return;
+    const char* node = "/dev/.fatal_log_blk";
+    const char* dir = "/dev/.fatal_log_mnt";
+    unlink(node);
+    if (mknod(node, S_IFBLK | 0600, makedev(maj, min)) != 0) return;
+    mkdir(dir, 0700);
+    if (mount(node, dir, "ext4", MS_NOATIME | MS_NODEV | MS_NOSUID, "") == 0) {
+        int size = klogctl(KLOG_SIZE_BUFFER, nullptr, 0);
+        if (size > 0) {
+            std::vector<char> buf(size);
+            int n = klogctl(KLOG_READ_ALL, buf.data(), size);
+            if (n > 0) {
+                std::string path = std::string(dir) + "/init_fatal_kmsg.txt";
+                rename(path.c_str(), (path + ".1").c_str());
+                android::base::unique_fd fd(
+                        open(path.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644));
+                if (fd >= 0) {
+                    std::string head = "reboot target: " + rebootTarget + "\n";
+                    android::base::WriteFully(fd, head.data(), head.size());
+                    android::base::WriteFully(fd, buf.data(), n);
+                    fsync(fd);
+                }
+            }
+        }
+        umount(dir);
+    }
+    rmdir(dir);
+    unlink(node);
+    sync();
+}
+
