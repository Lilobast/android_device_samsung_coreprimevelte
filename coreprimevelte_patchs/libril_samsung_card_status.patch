+/* coreprimevelte: Samsung libsec-ril (L) RIL_AppStatus carries five extra retry
+ * counters, so its card status struct is larger than AOSP's RIL_CardStatus_v6. */
+typedef struct {
+    RIL_AppType app_type;
+    RIL_AppState app_state;
+    RIL_PersoSubstate perso_substate;
+    char *aid_ptr;
+    char *app_label_ptr;
+    int pin1_replaced;
+    RIL_PinState pin1;
+    RIL_PinState pin2;
+    int pin1_num_retries;
+    int puk1_num_retries;
+    int pin2_num_retries;
+    int puk2_num_retries;
+    int perso_unblock_retries;
+} RIL_AppStatus_Samsung;
+
+typedef struct {
+    RIL_CardState card_state;
+    RIL_PinState universal_pin_state;
+    int gsm_umts_subscription_app_index;
+    int cdma_subscription_app_index;
+    int ims_subscription_app_index;
+    int num_applications;
+    RIL_AppStatus_Samsung applications[RIL_CARD_MAX_APPS];
+} RIL_CardStatus_Samsung;
+
+/* An app index that points past the app list means "none" (-1): with no SIM,
+ * libsec-ril reports index 0 and zero apps. */
+static int cardAppIndex(int index, int num) {
+    return (index < 0 || index >= num) ? -1 : index;
+}
