diff --git vendor/lineage/config/BoardConfigKernel.mk vendor/lineage/config/BoardConfigKernel.mk
index 9246da5..b5afc59 100644
--- vendor/lineage/config/BoardConfigKernel.mk
+++ vendor/lineage/config/BoardConfigKernel.mk
@@ -52,6 +52,15 @@ else
 KERNEL_ARCH := $(TARGET_KERNEL_ARCH)
 endif
 
+# Userspace kernel headers can use another arch than the kernel itself
+# (e.g. 32-bit userspace on an arm64 kernel).
+TARGET_KERNEL_HEADER_ARCH := $(strip $(TARGET_KERNEL_HEADER_ARCH))
+ifeq ($(TARGET_KERNEL_HEADER_ARCH),)
+KERNEL_HEADER_ARCH := $(KERNEL_ARCH)
+else
+KERNEL_HEADER_ARCH := $(TARGET_KERNEL_HEADER_ARCH)
+endif
+
 TARGET_KERNEL_CROSS_COMPILE_PREFIX := $(strip $(TARGET_KERNEL_CROSS_COMPILE_PREFIX))
 ifneq ($(TARGET_KERNEL_CROSS_COMPILE_PREFIX),)
 KERNEL_TOOLCHAIN_PREFIX ?= $(TARGET_KERNEL_CROSS_COMPILE_PREFIX)
