diff --git system/nfc/src/adaptation/NfcAdaptation.cc system/nfc/src/adaptation/NfcAdaptation.cc
index 528bdd7..97b65c9 100755
--- system/nfc/src/adaptation/NfcAdaptation.cc
+++ system/nfc/src/adaptation/NfcAdaptation.cc
@@ -623,7 +623,15 @@ bool NfcAdaptation::HalPrediscover() {
   const char* func = "NfcAdaptation::HalPrediscover";
   DLOG_IF(INFO, nfc_debug_enabled) << StringPrintf("%s", func);
   bool retval = FALSE;
-  mHal->prediscover();
+  // A legacy pre_discover() that returns non-zero has started vendor pre-discovery (Broadcom
+  // bcm2079x: pre-discovery config commands) and sends HAL_NFC_PRE_DISCOVER_CPLT_EVT when done;
+  // the HIDL wrappers report that as NfcStatus::FAILED. Return TRUE so the stack hands the HAL
+  // the command window and waits; otherwise both send NCI commands at once, responses get
+  // mixed up ("nfc_ncif_update_window: Unexpected call") and a command times out.
+  Return<::android::hardware::nfc::V1_0::NfcStatus> status = mHal->prediscover();
+  if (status.isOk() && status == ::android::hardware::nfc::V1_0::NfcStatus::FAILED) {
+    retval = TRUE;
+  }
   return retval;
 }
 
