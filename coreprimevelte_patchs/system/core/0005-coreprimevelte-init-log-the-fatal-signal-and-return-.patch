From e11a370443c974deab8b201ca47dd96a82dd3c41 Mon Sep 17 00:00:00 2001
From: builder <builder@localhost>
Date: Thu, 12 Nov 2026 00:03:46 +0100
Subject: [PATCH 5/7] coreprimevelte: init: log the fatal signal and return
 addresses before rebooting (bring-up)

Change-Id: Ieb9193d05bd12de94b68f44c58ec7de5fbb9fa82
---
 init/init.cpp | 60 +++++++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 58 insertions(+), 2 deletions(-)

diff --git a/init/init.cpp b/init/init.cpp
index eb9dd75..792fe60 100644
--- a/init/init.cpp
+++ b/init/init.cpp
@@ -459,6 +459,60 @@ static void set_usb_controller() {
     }
 }
 
+// coreprimevelte bring-up: write what killed init to the kernel log (saved to /cache by
+// RebootSystem). Symbolize with out/.../symbols/init: address - text start of "init" below.
+static void LogInitCrash(int signal, siginfo_t* info, void* ucontext) {
+    int fd = open("/dev/kmsg", O_WRONLY | O_CLOEXEC);
+    if (fd < 0) return;
+    char buf[512];
+    int n = snprintf(buf, sizeof(buf), "<3>init: fatal signal %d code %d addr %p\n", signal,
+                     info ? info->si_code : 0, info ? info->si_addr : nullptr);
+    write(fd, buf, n);
+    unsigned long text_start = 0, text_end = 0, stack_start = 0, stack_end = 0;
+    FILE* maps = fopen("/proc/self/maps", "re");
+    if (maps) {
+        char line[256];
+        while (fgets(line, sizeof(line), maps)) {
+            unsigned long s, e;
+            char perms[8];
+            if (strstr(line, "/init") && sscanf(line, "%lx-%lx %7s", &s, &e, perms) == 3 &&
+                perms[2] == 'x') {
+                text_start = s;
+                text_end = e;
+                n = snprintf(buf, sizeof(buf), "<3>init: map %s", line);
+                write(fd, buf, n);
+            }
+            if (strstr(line, "[stack]") && sscanf(line, "%lx-%lx", &s, &e) == 2) {
+                stack_start = s;
+                stack_end = e;
+            }
+        }
+        fclose(maps);
+    }
+#if defined(__arm__)
+    if (ucontext) {
+        const mcontext_t& mc = static_cast<ucontext_t*>(ucontext)->uc_mcontext;
+        n = snprintf(buf, sizeof(buf), "<3>init: pc %08lx lr %08lx sp %08lx fault %08lx\n",
+                     mc.arm_pc, mc.arm_lr, mc.arm_sp, mc.fault_address);
+        write(fd, buf, n);
+        // Return addresses into init's text found on the stack (a rough backtrace).
+        const unsigned long* sp = reinterpret_cast<const unsigned long*>(mc.arm_sp);
+        int found = 0;
+        if (mc.arm_sp < stack_start || mc.arm_sp >= stack_end) stack_end = 0;  // no scan
+        for (int i = 0; i < 512 && found < 24 &&
+                        reinterpret_cast<unsigned long>(&sp[i + 1]) <= stack_end; i++) {
+            unsigned long v = sp[i];
+            if (v >= text_start && v < text_end) {
+                n = snprintf(buf, sizeof(buf), "<3>init: stack[%d] %08lx\n", i, v);
+                write(fd, buf, n);
+                found++;
+            }
+        }
+    }
+#endif
+    close(fd);
+}
+
 static void InstallRebootSignalHandlers() {
     // Instead of panic'ing the kernel as is the default behavior when init crashes,
     // we prefer to reboot to bootloader on development builds, as this will prevent
@@ -467,20 +521,22 @@ static void InstallRebootSignalHandlers() {
     struct sigaction action;
     memset(&action, 0, sizeof(action));
     sigfillset(&action.sa_mask);
-    action.sa_handler = [](int signal) {
+    action.sa_sigaction = [](int signal, siginfo_t* info, void* ucontext) {
         // These signal handlers are also caught for processes forked from init, however we do not
         // want them to trigger reboot, so we directly call _exit() for children processes here.
         if (getpid() != 1) {
             _exit(signal);
         }
 
+        LogInitCrash(signal, info, ucontext);
+
         // Calling DoReboot() or LOG(FATAL) is not a good option as this is a signal handler.
         // RebootSystem uses syscall() which isn't actually async-signal-safe, but our only option
         // and probably good enough given this is already an error case and only enabled for
         // development builds.
         RebootSystem(ANDROID_RB_RESTART2, "bootloader");
     };
-    action.sa_flags = SA_RESTART;
+    action.sa_flags = SA_RESTART | SA_SIGINFO;
     sigaction(SIGABRT, &action, nullptr);
     sigaction(SIGBUS, &action, nullptr);
     sigaction(SIGFPE, &action, nullptr);
-- 
