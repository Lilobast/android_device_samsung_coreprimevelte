# Wi-Fi init file
on init
    # for sd8xxx wifi and bluetooth power
    chown system system /sys/class/rfkill/rfkill0/state
    chown system system /sys/class/rfkill/rfkill1/state

    chmod 0660 /sys/devices/platform/sd8x-rfkill/pwr_ctrl
    chown system system /sys/devices/platform/sd8x-rfkill/pwr_ctrl

    # Marvell Builtin Parameters
    chown system system /sys/module/sd8777/parameters/mac_addr
    chown system system /sys/module/sd8777/parameters/reg_alpha2
    chown system system /sys/module/sd8777/parameters/auto_ds
    chown system system /sys/module/sd8777/parameters/ps_mode
    chown system system /sys/module/sd8777/parameters/hw_test
    chown system system /sys/module/sd8777/parameters/mfg_mode
    chown system system /sys/module/sd8777/parameters/fw_name
    chown system system /sys/module/sd8777/parameters/cfg80211_wext

on post-fs-data
    # create directory for hostapd
    mkdir /data/hostapd 0770 system wifi

    # create folder to save wifi/bt config files with mac address, and calibrate files
    mkdir /data/misc/wireless 0771 system system

    # give system access to wpa_supplicant.conf for backup and restore
    mkdir /data/misc/wifi 0770 wifi system
    chmod 0660 /data/misc/wifi/wpa_supplicant.conf
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/dhcp 0775 dhcp dhcp
    chown dhcp dhcp /data/misc/dhcp
    mkdir /data/misc/simal 0775 wifi system
    chmod 0775 /data/misc/simal

	# for WIFI TRP/TIS
    chown system root /data/.psm.info
    chmod 0664 /data/.psm.info

    # for WIFI Antenna Selection
    chown system root /data/.ant.info
    chmod 0664 /data/.ant.info

    # for WIFI Version
    write /data/.wifiver.info 0
    chown system root /data/.wifiver.info
    chmod 0664 /data/.wifiver.info

    # for WIFI Cert
    chmod 0664 /data/.bustxglom.info
    chmod 0664 /data/.roamoff.info
    chmod 0664 /data/.frameburst.info
    chmod 0664 /data/.txbf.info
    # for WIFI MAC address
    mkdir /efs/wifi 0775 radio system
    chown system wifi /efs/wifi/.mac.info
    chmod 0660 /efs/wifi/.mac.info

on boot
    setprop wifi.interface wlan0

# Pie: one wpa_supplicant for STA and P2P, driven by the framework over HIDL
# (configs under /data/vendor/wifi/wpa, overlays in /vendor/etc/wifi).
# hostapd comes with its own rc (external/wpa_supplicant_8); DHCP runs in the framework.
service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
    -O/data/vendor/wifi/wpa/sockets -puse_p2p_group_interface=1 \
    -g@android:wpa_wlan0
    interface android.hardware.wifi.supplicant@1.0::ISupplicant default
    interface android.hardware.wifi.supplicant@1.1::ISupplicant default
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

# init.rc does not yet support applying capabilities, so run as root and
# let wireless daemon drop uid to system with the right linux capabilities
service mwirelessd /system/bin/MarvellWirelessDaemon
    class main

